{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=printguard_db;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "PrintGuardSecretKeyMustBe32CharactersOrMore_SuperSecure2026",
    "Issuer": "PrintGuardServer",
    "Audience": "PrintGuardClients"
  },
  "PrintGuard": {
    "RememberMeDurationHours": 8,
    "RequireAuthEveryJob": true,
    "HoldQueueNamePattern": "{PrinterName}-HOLD"
  }
}
