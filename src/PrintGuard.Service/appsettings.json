{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "PrintGuard": {
    "ApiBaseUrl": "http://localhost:5000/api/v1",
    "HeartbeatIntervalSeconds": 60,
    "QueuePollIntervalSeconds": 2,
    "WatchedPrinters": [
      "PRN-LAN-01-FINANCE",
      "PRN-LAN-02-COLOR",
      "PRN-LAN-03-HR"
    ]
  }
}
