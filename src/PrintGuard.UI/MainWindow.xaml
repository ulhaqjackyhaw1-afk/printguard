<Window x:Class="PrintGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PrintGuard - Print Authorization" 
        Height="580" Width="460"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, sans-serif"
        ResizeMode="NoResize">

    <Border Background="{StaticResource SurfaceBrush}" 
            CornerRadius="14" 
            BorderBrush="{StaticResource BorderBrush}" 
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Print Job Card -->
                <RowDefinition Height="*"/>    <!-- Credentials Form -->
                <RowDefinition Height="Auto"/> <!-- Footer Buttons & Status -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10" Background="#EFF6FF" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🖨️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PrintGuard" FontWeight="Bold" FontSize="16" Foreground="{StaticResource PrimaryBrush}"/>
                    <TextBlock Text="Print Authorization Required" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextDarkBrush}"/>
                </StackPanel>

                <!-- Close / Cancel Button -->
                <Button Grid.Column="2" Content="✕" Width="28" Height="28" 
                        Background="Transparent" Foreground="{StaticResource TextMutedBrush}" 
                        BorderThickness="0" FontSize="14" Cursor="Hand" Click="CloseButton_Click"/>
            </Grid>

            <!-- Job Info Card -->
            <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="14" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Document:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDocName" Text="Document.pdf" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Printer:" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,0,10,4"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtPrinterName" Text="PRN-LAN-01" Foreground="{StaticResource TextDarkBrush}" FontSize="12"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Status:" Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                    <Border Grid.Row="2" Grid.Column="1" Background="#FEF3C7" CornerRadius="6" HorizontalAlignment="Left" Padding="6,2">
                        <TextBlock Text="HELD - Waiting Login" Foreground="#B45309" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Form -->
            <StackPanel Grid.Row="2" VerticalAlignment="Top">
                <!-- Error Banner -->
                <Border x:Name="BorderError" Background="#FEE2E2" CornerRadius="8" Padding="10" Margin="0,0,0,12" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Text="Invalid credentials" Foreground="{StaticResource ErrorBrush}" FontSize="12" TextWrapping="Wrap"/>
                </Border>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtUsername" Height="38" Padding="10,8" FontSize="13" 
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,0,0,12">
                    <TextBox.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDarkBrush}" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="TxtPassword" Height="38" Padding="10,8" FontSize="13" 
                                 BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <PasswordBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>
                </Grid>

                <!-- Remember Me Checkbox -->
                <CheckBox x:Name="ChkRememberMe" Margin="0,0,0,16" VerticalAlignment="Center">
                    <TextBlock Text="Remember me on this computer (8 hours)" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </CheckBox>
            </StackPanel>

            <!-- Actions & Status Footer -->
            <StackPanel Grid.Row="3">
                <Button x:Name="BtnAuthorize" Content="Authorize &amp; Print" Style="{StaticResource ModernButton}" Height="42" Margin="0,0,0,8" Click="BtnAuthorize_Click"/>
                <Button x:Name="BtnCancel" Content="Cancel Print Job" Style="{StaticResource SecondaryButton}" Height="36" Click="BtnCancel_Click"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessColor}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Server Connected" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
